        },
        {
          "ruleId": "webhook-not-https",
          "ruleIndex": 21,
          "level": "error",
          "message": {
            "text": "The webhook URL uses http, not https, so payment events cross the network in clear text and can be read or changed on the way. Stripe asks for a public HTTPS address and allows plain HTTP only on a developer's own machine. Fix: Give the webhook a public https URL."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
                  "index": 0
