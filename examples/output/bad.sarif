        {
          "ruleId": "webhook-idempotency-missing",
          "ruleIndex": 25,
          "level": "error",
          "message": {
            "text": "The webhook names no idempotencyKey, so an event delivered twice can count one payment twice. Stripe says an endpoint may receive an event more than once and asks it to skip the ids it has handled. Fix: Name the field that identifies an event, such as event.id, record each one handled, and skip one seen before."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
                  "index": 0
