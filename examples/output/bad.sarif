        {
          "ruleId": "invoice-expiry-below-confirmation-time",
          "ruleIndex": 18,
          "level": "warning",
          "message": {
            "text": "The invoice expires after 600 seconds (10 minutes), but a payment in asset USDC on ethereum takes about 768 seconds to reach the finalized checkpoint: the invoice must be paid before it expires, so a payment sent on time can run out before it is marked paid, and the payer is asked for more or refunded by hand. The Bitcoin developer guide warns of this with a short expiry. Fix: Let the invoice run longer than the time to confirm on every network it accepts, or hold an invoice open once its payment is detected and write expiryRequires \"detected\"."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
                  "index": 0
                },
                "region": {
