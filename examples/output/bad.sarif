        {
          "ruleId": "payment-tolerance-missing",
          "ruleIndex": 20,
          "level": "warning",
          "message": {
            "text": "The invoice has no overpaymentTolerance, so what the checkout does with a payment that is a little short or a little over is not written down: it may be lost, refused or counted in full. This is a best practice of this tool, not a rule in the pages it cites. Fix: Give an underpaymentTolerance and an overpaymentTolerance in percent, from 0, and say what the checkout does with a payment outside them."
          },
          "locations": [
