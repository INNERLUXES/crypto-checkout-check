        {
          "ruleId": "confirmations-below-default",
          "ruleIndex": 7,
          "level": "warning",
          "message": {
            "text": "Asset ETH on ethereum marks an invoice paid after 3 confirmations, fewer than the tool's starting point of 12 for Ethereum; a block that is replaced takes the payment with it. This is a best practice of this tool, not a rule in the pages it cites. Fix: Raise the confirmations of the asset, wait for the finalized checkpoint on an EVM network, or set the threshold your team has chosen with --min-confirmations and record why."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
