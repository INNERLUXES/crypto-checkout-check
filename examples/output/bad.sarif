        {
          "ruleId": "webhook-weak-signature",
          "ruleIndex": 23,
          "level": "error",
          "message": {
            "text": "The webhook is signed with \"hmac-sha1\", which is weaker than HMAC-SHA256. GitHub keeps HMAC-SHA1 for older code only and signs with HMAC-SHA256, as Stripe does. Fix: Sign webhooks with HMAC-SHA256, and compare signatures in constant time."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
