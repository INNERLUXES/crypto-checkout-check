        {
          "ruleId": "webhook-replay-unprotected",
          "ruleIndex": 24,
          "level": "warning",
          "message": {
            "text": "The webhook has a timestampTolerance of 0, so a payment event captured once can be sent again later and still pass. Stripe signs a timestamp with each event, allows 5 minutes by default and says a tolerance of 0 turns the check off. Fix: Sign a timestamp with every event and refuse one older than a tolerance, such as the 5 minutes of the Stripe libraries."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
