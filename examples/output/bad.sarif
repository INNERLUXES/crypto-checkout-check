            "entry": "USDC on ethereum"
          }
        },
        {
          "ruleId": "rate-lock-exceeds-expiry",
          "ruleIndex": 19,
          "level": "warning",
          "message": {
            "text": "The quoted rate is held for 1,800 seconds (30 minutes), longer than the 600 seconds (10 minutes) the invoice runs, so a quote outlives its invoice and a payment after the expiry can still be priced at it. This is a best practice of this tool, not a rule in the pages it cites. Fix: Hold the rate no longer than the invoice runs, and quote again for a payment that comes after."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
