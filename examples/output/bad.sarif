        {
          "ruleId": "webhook-retry-missing",
          "ruleIndex": 26,
          "level": "warning",
          "message": {
            "text": "The webhook retries 0 times, so a payment event lost to one failed delivery is never sent again and the invoice stays unpaid. Stripe retries for up to three days with exponential back off. Fix: Retry failed deliveries with exponential back off over hours or days, and let an operator send an event again by hand."
          },
          "locations": [
