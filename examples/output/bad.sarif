        {
          "ruleId": "paid-before-finality",
          "ruleIndex": 10,
          "level": "warning",
          "message": {
            "text": "Asset ETH on ethereum marks an invoice paid after 3 confirmations, before its block is finalized, and its largest invoice, 50000 USD, is above the --large-payment limit of 1000 USD. The page of ethereum.org on proof-of-stake says a block is final only once a checkpoint above it is justified and then finalized, which takes at least two epochs of 32 slots of 12 seconds. Fix: Mark an Ethereum invoice of high value paid once its block is finalized (commitment \"finalized\"), or give the asset a maxAmount at or below --large-payment."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/checkout.json",
                  "index": 0
