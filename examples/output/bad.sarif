          }
        },
        {
          "ruleId": "evm-paid-before-finality",
          "ruleIndex": 11,
          "level": "warning",
          "message": {
            "text": "Asset USDC on base marks an invoice paid after 12 confirmations, before its block is finalized, and its largest invoice, 5000 USD, is above the --large-payment limit of 1000 USD. This is a best practice of this tool, not a rule in the pages it cites. Fix: Mark an invoice of high value paid once the network reports its block as finalized (commitment \"finalized\"), or give the asset a maxAmount at or below --large-payment."
          },
          "locations": [
